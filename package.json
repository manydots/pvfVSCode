{
  "name": "pvf-vscode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VS Code Monaco编辑器",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:outline": "node scripts/check-outline.mjs",
    "check:breadcrumbs": "node scripts/check-breadcrumbs.mjs",
    "check:language-associations": "node scripts/check-language-associations.mjs",
    "check:language-configuration": "node scripts/check-language-configuration.mjs",
    "check:encoding-oracle": "node scripts/check-encoding-oracle.mjs",
    "check:command-center": "node scripts/check-command-center.mjs",
    "check:quickinput": "node scripts/check-quickinput.mjs",
    "check:menu-toggle": "node scripts/check-menu-toggle.mjs",
    "check:layout-state": "node scripts/check-layout-state.mjs",
    "check:configuration": "node scripts/check-configuration.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "check:syntax-colors": "node scripts/check-syntax-colors.mjs",
    "check:token-comments": "node scripts/check-token-comments.mjs",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@vscode/iconv-lite-umd": "^0.7.1",
    "jschardet": "^3.1.4",
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "prettier": "3.9.6",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  }
}
